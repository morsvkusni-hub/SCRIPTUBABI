local VALID_KEY = "@kotyk_software"

local function keyCheck()
    local PG = LP:WaitForChild("PlayerGui")

    local kgui = Instance.new("ScreenGui")
    kgui.Name = "kotyk_key"
    kgui.ResetOnSpawn = false
    kgui.Parent = PG

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(0, 340, 0, 180)
    bg.Position = UDim2.new(0.5, -170, 0.5, -90)
    bg.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    bg.BorderSizePixel = 0
    bg.Parent = kgui
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", bg)
    stroke.Color = Color3.fromRGB(255, 90, 90)
    stroke.Thickness = 1

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.BackgroundTransparency = 1
    title.Text = "@kotyk_software"
    title.TextColor3 = Color3.fromRGB(255, 90, 90)
    title.TextSize = 20
    title.Font = Enum.Font.GothamBold
    title.Parent = bg

    local sub = Instance.new("TextLabel")
    sub.Size = UDim2.new(1, 0, 0, 20)
    sub.Position = UDim2.new(0, 0, 0, 36)
    sub.BackgroundTransparency = 1
    sub.Text = "Enter key to continue"
    sub.TextColor3 = Color3.fromRGB(180, 180, 190)
    sub.TextSize = 12
    sub.Font = Enum.Font.Gotham
    sub.Parent = bg

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -40, 0, 36)
    box.Position = UDim2.new(0, 20, 0, 70)
    box.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
    box.BorderSizePixel = 0
    box.PlaceholderText = "Key..."
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(230, 230, 235)
    box.PlaceholderColor3 = Color3.fromRGB(120, 120, 130)
    box.TextSize = 14
    box.Font = Enum.Font.GothamMedium
    box.ClearTextOnFocus = false
    box.Parent = bg
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -40, 0, 34)
    btn.Position = UDim2.new(0, 20, 0, 116)
    btn.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
    btn.Text = "Submit"
    btn.TextColor3 = Color3.new(1,1,1)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.Parent = bg
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 0, 16)
    status.Position = UDim2.new(0, 0, 1, -20)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(255, 90, 90)
    status.TextSize = 11
    status.Font = Enum.Font.Gotham
    status.Parent = bg

    local done = false
    local function try()
        if box.Text == VALID_KEY then
            done = true
            status.Text = "Access granted!"
            status.TextColor3 = Color3.fromRGB(80, 200, 120)
            task.wait(0.5)
            kgui:Destroy()
        else
            status.Text = "Wrong key!"
            status.TextColor3 = Color3.fromRGB(255, 90, 90)
            box.Text = ""
        end
    end

    btn.MouseButton1Click:Connect(try)
    box.FocusLost:Connect(function(enter) if enter then try() end end)

    -- ждём ввода
    repeat task.wait(0.1) until done or not kgui.Parent
    return done
end

if not keyCheck() then
    return
end


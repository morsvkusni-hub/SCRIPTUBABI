--==========================================================
--          MOVEMENT TAB
--==========================================================
local MovementTab = Plugins:CreateTab({ "Movement", "Fly and jump" }) do
    MovementTab:Section("Fly", function(Section)
        Plugins:SetDefault("Fly", false)
        Plugins:SetDefault("FlySpeed", 60)

        Plugins:Toggle(Section, {
            "Fly", "WASD move, Space up, LeftCtrl down"
        }, "Fly", function(Value)
            if Value then
                Movement:StartFly()
            else
                Movement:StopFly()
            end
        end)

        Plugins:Slider(Section, {
            "Fly Speed", "Speed of flight"
        }, { 20, 300, 5 }, "FlySpeed", function(Value)
            Movement:SetFlySpeed(Value)
        end)
    end)

    MovementTab:Section("Jump", function(Section)
        Plugins:SetDefault("InfiniteJump", false)

        Plugins:Toggle(Section, {
            "Infinite Jump", "Jump as many times as you want"
        }, "InfiniteJump", function(Value)
            if Value then
                Movement:StartInfiniteJump()
            else
                Movement:StopInfiniteJump()
            end
        end)
    end)
end

Plugins:Managers()


--              AIMBOT (с distance check)
--==========================================================
RunService.RenderStepped:Connect(function()
    if not Config.Aimbot.Enabled then return end
    local s = Config.Aimbot
    local myRoot = getRoot(); if not myRoot then return end
    local closest, best = nil, s.FOV
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if s.TeamCheck and plr.Team and plr.Team == LP.Team then continue end
        local char = plr.Character; if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(s.TargetPart); if not part then continue end
        local dist = (part.Position - myRoot.Position).Magnitude
        if dist > s.MaxDistance then continue end
        local sp, onS = Camera:WorldToViewportPoint(part.Position)
        if not onS then continue end
        if s.WallCheck then
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = {LP.Character}
            local ray = Workspace:Raycast(Camera.CFrame.Position,
                (part.Position - Camera.CFrame.Position).Unit * 1000, rp)
            if ray and not ray.Instance:IsDescendantOf(char) then continue end
        end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < best then closest, best = part, d end
    end
    if closest then
        local target = CFrame.new(Camera.CFrame.Position, closest.Position)
        Camera.CFrame = Camera.CFrame:Lerp(target, s.Smoothness)
    end
end)


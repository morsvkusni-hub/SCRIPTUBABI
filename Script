--==========================================================
--          AIMBOT TAB
--==========================================================
local AimbotTab = Plugins:CreateTab({ "Aimbot", "Automatic aiming" }) do
    AimbotTab:Section("Aimbot", function(Section)
        Plugins:SetDefault("SilentAim", false)
        Plugins:SetDefault("TargetMode", "Nearest")
        Plugins:SetDefault("TargetPart", "HumanoidRootPart")
        Plugins:SetDefault("Distance", 300)
        Plugins:SetDefault("FOV", 100)
        Plugins:SetDefault("CheckWall", true)
        Plugins:SetDefault("CheckTeam", false)
        Plugins:SetDefault("TargetBots", true)

        Plugins:Toggle(Section, { "Silent Aim", "Redirect bullets to the nearest target" }, "SilentAim", function(v)
            if v then Aimbot:Enable() else Aimbot:Disable() end
        end)
        Plugins:Dropdown(Section, "Target Mode", { "Nearest", "FOV" }, "TargetMode", function(v) end)
        Plugins:Dropdown(Section, "Target Part", { "Head", "HumanoidRootPart" }, "TargetPart", function(v) end)
        Plugins:Slider(Section, { "Distance", "Maximum distance to acquire the target" }, { 50, 400, 10 }, "Distance", function(v) end)
        Plugins:Slider(Section, { "FOV", "Maximum distance from the crosshair" }, { 10, 300, 5 }, "FOV", function(v) end)
        Plugins:Toggle(Section, { "Check Wall", "Ignore targets behind walls" }, "CheckWall", function(v) end)
        Plugins:Toggle(Section, { "Check Team", "Ignore same team players" }, "CheckTeam", function(v) end)
        Plugins:Toggle(Section, { "Target Bots", "Aim at bots with the IsBot attribute" }, "TargetBots", function(v) end)
    end)
end


local ESP = { boxes = {}, tracers = {}, names = {}, conn = nil }

local function mkESPFor(plr)
    if not hasDrawing() then return end
    local box = Drawing.new("Square")
    box.Thickness = 1; box.Color = Config.Visuals.ESPColor
    box.Filled = false; box.Visible = false
    ESP.boxes[plr] = box

    local line = Drawing.new("Line")
    line.Thickness = 1; line.Color = Config.Visuals.ESPColor; line.Visible = false
    ESP.tracers[plr] = line

    local txt = Drawing.new("Text")
    txt.Size = 14; txt.Center = true; txt.Outline = true
    txt.Color = Color3.new(1,1,1); txt.Visible = false
    ESP.names[plr] = txt
end

local function destroyESPFor(plr)
    if ESP.boxes[plr] then ESP.boxes[plr]:Remove(); ESP.boxes[plr] = nil end
    if ESP.tracers[plr] then ESP.tracers[plr]:Remove(); ESP.tracers[plr] = nil end
    if ESP.names[plr] then ESP.names[plr]:Remove(); ESP.names[plr] = nil end
end

startESP = function()
    if not hasDrawing() then
        warn("[@kotyk_software] Drawing API недоступен")
        return
    end
    if ESP.conn then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then mkESPFor(p) end
    end
    ESP.conn = RunService.RenderStepped:Connect(function()
        local myRoot = getRoot()
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            if not ESP.boxes[p] then mkESPFor(p) end
            local hrp = otherRoot(p)
            local box, line, txt = ESP.boxes[p], ESP.tracers[p], ESP.names[p]
            if hrp and box and line and txt then
                local pos, onS = Camera:WorldToViewportPoint(hrp.Position)
                if onS then
                    local head = p.Character and p.Character:FindFirstChild("Head")
                    local hp = head and Camera:WorldToViewportPoint(head.Position)
                    local h = hp and math.abs(hp.Y - pos.Y) * 1.8 or 60
                    local w = h * 0.5

                    if Config.Visuals.ESP then
                        box.Size = Vector2.new(w, h)
                        box.Position = Vector2.new(pos.X - w/2, pos.Y - h/2)
                        box.Visible = true
                    else box.Visible = false end

                    if Config.Visuals.Tracers then
                        line.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                        line.To = Vector2.new(pos.X, pos.Y)
                        line.Visible = true
                    else line.Visible = false end

                    if Config.Visuals.Names or Config.Visuals.Distance then
                        local text = ""
                        if Config.Visuals.Names then text = p.Name end
                        if Config.Visuals.Distance then
                            local d = myRoot and math.floor((myRoot.Position - hrp.Position).Magnitude) or 0
                            text = (text ~= "" and (text .. " | ") or "") .. d .. "m"
                        end
                        txt.Text = text
                        txt.Position = Vector2.new(pos.X, pos.Y - h/2 - 15)
                        txt.Visible = true
                    else txt.Visible = false end
                else
                    box.Visible = false; line.Visible = false; txt.Visible = false
                end
            else
                if box then box.Visible = false end
                if line then line.Visible = false end
                if txt then txt.Visible = false end
            end
        end
    end)
end

stopESP = function()
    if ESP.conn then ESP.conn:Disconnect(); ESP.conn = nil end
    for p, _ in pairs(ESP.boxes) do destroyESPFor(p) end
end


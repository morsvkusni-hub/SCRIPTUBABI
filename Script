--==========================================================
--              Skeleton ESP (R6 + R15)
--==========================================================
local Skeleton = { lines = {}, conn = nil }
local SKEL_R6 = {
    {"Head","Torso"}, {"Torso","Left Arm"}, {"Torso","Right Arm"},
    {"Torso","Left Leg"}, {"Torso","Right Leg"},
}
local SKEL_R15 = {
    {"Head","UpperTorso"}, {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"}, {"LeftUpperArm","LeftLowerArm"}, {"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"}, {"RightUpperArm","RightLowerArm"}, {"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"}, {"LeftUpperLeg","LeftLowerLeg"}, {"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"}, {"RightUpperLeg","RightLowerLeg"}, {"RightLowerLeg","RightFoot"},
}

local function mkSkelLines(plr, count)
    Skeleton.lines[plr] = Skeleton.lines[plr] or {}
    for i = 1, count do
        if not Skeleton.lines[plr][i] then
            local l = Drawing.new("Line")
            l.Thickness = 1; l.Color = Color3.fromRGB(255, 255, 255); l.Visible = false
            Skeleton.lines[plr][i] = l
        end
    end
end

local function destroySkel(plr)
    if Skeleton.lines[plr] then
        for _, l in ipairs(Skeleton.lines[plr]) do l:Remove() end
        Skeleton.lines[plr] = nil
    end
end

startSkeleton = function()
    if not hasDrawing() then return end
    if Skeleton.conn then return end
    Skeleton.conn = RunService.RenderStepped:Connect(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            local char = p.Character
            if not char then destroySkel(p); continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then destroySkel(p); continue end
            local rig = hum.RigType
            local layout = rig == Enum.HumanoidRigType.R15 and SKEL_R15 or SKEL_R6
            if not Skeleton.lines[p] then mkSkelLines(p, #layout) end
            for i, pair in ipairs(layout) do
                local a = char:FindFirstChild(pair[1])
                local b = char:FindFirstChild(pair[2])
                local line = Skeleton.lines[p][i]
                if a and b and line then
                    local pa, oa = Camera:WorldToViewportPoint(a.Position)
                    local pb, ob = Camera:WorldToViewportPoint(b.Position)
                    if oa and ob then
                        line.From = Vector2.new(pa.X, pa.Y)
                        line.To = Vector2.new(pb.X, pb.Y)
                        line.Visible = true
                    else line.Visible = false end
                elseif line then line.Visible = false end
            end
        end
    end)
end

stopSkeleton = function()
    if Skeleton.conn then Skeleton.conn:Disconnect(); Skeleton.conn = nil end
    for p, _ in pairs(Skeleton.lines) do destroySkel(p) end
end


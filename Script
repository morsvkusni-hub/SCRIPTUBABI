--==========================================================
--              SILENT AIM (SAFE)
--==========================================================
local SilentHooks = {}
local silentActive = false

local function startSilent()
    if SilentHooks.namecall then return end

    local myMouse = LP:GetMouse()
    local localCharRef = LP.Character
    local charConn = LP.CharacterAdded:Connect(function(c) localCharRef = c end)

    local function isActive()
        local key = Config.SilentAim.HoldKey
        if not key then return true end
        if key.EnumType == Enum.UserInputType then
            return UIS:IsMouseButtonPressed(key)
        end
        return UIS:IsKeyDown(key)
    end

    local function getTarget()
        local s = Config.SilentAim
        local closest, best = nil, s.FOV
        local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LP then continue end
            if s.TeamCheck and plr.Team and plr.Team == LP.Team then continue end
            local char = plr.Character; if not char then continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local part = char:FindFirstChild(s.TargetPart); if not part then continue end
            local sp, onS = Camera:WorldToViewportPoint(part.Position)
            if not onS then continue end
            if s.WallCheck then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {localCharRef}
                local ray = Workspace:Raycast(Camera.CFrame.Position,
                    (part.Position - Camera.CFrame.Position).Unit * 1000, rp)
                if ray and not ray.Instance:IsDescendantOf(char) then continue end
            end
            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if d < best then closest, best = plr, d end
        end
        return closest
    end

    local function getPredicted(target)
        local s = Config.SilentAim
        local char = target and target.Character; if not char then return nil end
        local part = char:FindFirstChild(s.TargetPart); if not part then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude > 0 then
            return part.Position + hum.MoveDirection * hum.WalkSpeed * s.Prediction
        end
        return part.Position
    end

    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if not Config.SilentAim.Enabled or not isActive() or checkcaller() then
            return oldNamecall(self, ...)
        end
        local method = getnamecallmethod()
        local args = {...}
        if Config.SilentAim.UseRemote and (method == "FireServer" or method == "InvokeServer") then
            local hasVector = false
            for _, v in ipairs(args) do
                if typeof(v) == "Vector3" or typeof(v) == "CFrame" then
                    hasVector = true; break
                end
            end
            if hasVector then
                local t = getTarget()
                if t then
                    local pos = getPredicted(t)
                    if pos then
                        for i, v in ipairs(args) do
                            if typeof(v) == "Vector3" then args[i] = pos
                            elseif typeof(v) == "CFrame" then args[i] = CFrame.new(pos) end
                        end
                        return oldNamecall(self, table.unpack(args))
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    SilentHooks.namecall = oldNamecall

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if Config.SilentAim.Enabled and Config.SilentAim.UseMouse
        and isActive() and not checkcaller() then
            if self == myMouse and (key == "Hit" or key == "Target") then
                local t = getTarget()
                if t then
                    local pos = getPredicted(t)
                    if pos then
                        if key == "Hit" then return CFrame.new(pos)
                        elseif key == "Target" then return t.Character end
                    end
                end
            end
        end
        return oldIndex(self, key)
    end)
    SilentHooks.index = oldIndex
    SilentHooks.charConn = charConn

    print("[@kotyk_software] Silent Aim: ON")
end

local function stopSilent()
    if SilentHooks.namecall then
        hookmetamethod(game, "__namecall", SilentHooks.namecall)
        SilentHooks.namecall = nil
    end
    if SilentHooks.index then
        hookmetamethod(game, "__index", SilentHooks.index)
        SilentHooks.index = nil
    end
    if SilentHooks.charConn then
        SilentHooks.charConn:Disconnect()
        SilentHooks.charConn = nil
    end
    print("[@kotyk_software] Silent Aim: OFF")
end

RunService.Heartbeat:Connect(function()

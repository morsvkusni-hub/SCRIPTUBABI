        local gap, len = 5, 12
        up.From = Vector2.new(cx, cy - gap);     up.To = Vector2.new(cx, cy - gap - len)
        dn.From = Vector2.new(cx, cy + gap);     dn.To = Vector2.new(cx, cy + gap + len)
        lf.From = Vector2.new(cx - gap, cy);     lf.To = Vector2.new(cx - gap - len, cy)
        rt.From = Vector2.new(cx + gap, cy);     rt.To = Vector2.new(cx + gap + len, cy)
    end))
end


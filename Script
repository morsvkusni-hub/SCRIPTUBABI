RunService.RenderStepped:Connect(function()
    -- FOV Circle
    if Settings.ShowFOV then
        fovCircle.Visible = true
        fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
        fovCircle.Radius = Settings.FOV
    else
        fovCircle.Visible = false
    end

    -- Target Dot
    if Settings.ShowTarget and Settings.Enabled then
        local t = getTarget()
        if t then
            local sp, onS = Camera:WorldToViewportPoint(t.Position)
            if onS then
                targetDot.Visible = true
                targetDot.Position = Vector2.new(sp.X, sp.Y)
            else
                targetDot.Visible = false
            end
        else
            targetDot.Visible = false
        end
    else
        targetDot.Visible = false
    end

    -- AIMBOT
    if Settings.Enabled and isHolding() then
        local t = getTarget()
        if t then
            local targetCF = CFrame.new(Camera.CFrame.Position, t.Position)
            Camera.CFrame = Camera.CFrame:Lerp(targetCF, Settings.Smoothness)
        end
    end
end)

--==========================================================
--          AGGRESSIVE MODE (хуки — риск кика)
--==========================================================
local Hooks = { nc = nil, idx = nil }

local function startAggressive()
    if Hooks.nc then return end

    local Mouse = LP:GetMouse()

    local oldNC
    oldNC = hookmetamethod(game, "__namecall", newcclosure(function(...)
        local method = getnamecallmethod()
        local args = {...}
        local self = args[1]

        if not checkcaller() and Settings.Enabled and isHolding() then
            if self == workspace and (method == "Raycast" or method == "FindPartOnRay"
            or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRayWithWhitelist") then
                local target = getTarget()
                if target then
                    if method == "Raycast" then
                        if typeof(args[2]) == "Vector3" and typeof(args[3]) == "Vector3" then
                            local origin = args[2]
                            args[3] = (target.Position - origin).Unit * 1000
                            return oldNC(table.unpack(args))
                        end
                    else
                        local aRay = args[2]
                        if typeof(aRay) == "Ray" then
                            local origin = aRay.Origin
                            args[2] = Ray.new(origin, (target.Position - origin).Unit * 1000)
                            return oldNC(table.unpack(args))
                        end
                    end
                end
            end
        end
        return oldNC(...)
    end))

    local oldIdx
    oldIdx = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if not checkcaller() and Settings.Enabled and isHolding() and self == Mouse then
            if key == "Hit" then
                local t = getTarget()
                if t then return t.CFrame end
            elseif key == "Target" then
                local t = getTarget()
                if t then return t end
            end
        end
        return oldIdx(self, key)
    end))

    Hooks.nc = oldNC
    Hooks.idx = oldIdx
    warn("[@kotyk_software] AGGRESSIVE MODE — риск кика!")
end

local function stopAggressive()
    if Hooks.nc then
        hookmetamethod(game, "__namecall", Hooks.nc); Hooks.nc = nil
    end
    if Hooks.idx then
        hookmetamethod(game, "__index", Hooks.idx); Hooks.idx = nil
    end
    print("[@kotyk_software] Aggressive mode OFF")
end

RunService.Heartbeat:Connect(function()
    if Settings.AggressiveMode and not Hooks.nc then
        startAggressive()
    elseif not Settings.AggressiveMode and Hooks.nc then
        stopAggressive()
    end
end)


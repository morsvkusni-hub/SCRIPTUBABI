-- 7. Aimbot (СУПЕР-ТОЧНЫЙ через hookmetamethod)
Features["Aimbot"] = function(on, name)
    clearFeature(name)
    if not on then return end

    local settings = {
        targetPart = activeData["aimBone"] or "Head",
        fov        = 200,
        wallCheck  = true,
        teamCheck  = true,
        prediction = 0.15,
        useMouse   = true,
        useRemote  = true,
        holdKey    = nil, -- напр. Enum.UserInputType.MouseButton2
    }

    local myMouse = player:GetMouse()
    local localCharRef = player.Character

    local function getTarget()
        local closest, bestDist = nil, settings.fov
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == player then continue end
            if settings.teamCheck and plr.Team and plr.Team == player.Team then continue end
            local char = plr.Character; if not char then continue end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then continue end
            local part = char:FindFirstChild(settings.targetPart)
            if not part then continue end
            local sp, onS = camera:WorldToViewportPoint(part.Position)
            if not onS then continue end
            if settings.wallCheck then
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Exclude
                rp.FilterDescendantsInstances = {localCharRef}
                local ray = workspace:Raycast(camera.CFrame.Position,
                    (part.Position - camera.CFrame.Position).Unit * 1000, rp)
                if ray and not ray.Instance:IsDescendantOf(char) then continue end
            end
            local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if d < bestDist then closest, bestDist = plr, d end
        end
        return closest
    end

    local function getPredicted(target)
        local char = target and target.Character; if not char then return nil end
        local part = char:FindFirstChild(settings.targetPart); if not part then return nil end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.MoveDirection.Magnitude > 0 then
            local vel = hum.MoveDirection * hum.WalkSpeed
            return part.Position + vel * settings.prediction
        end
        return part.Position
    end

    local function isActive()
        if not settings.holdKey then return true end
        if typeof(settings.holdKey) == "EnumItem" then
            if settings.holdKey.EnumType == Enum.UserInputType then
                return UIS:IsMouseButtonPressed(settings.holdKey)
            else
                return UIS:IsKeyDown(settings.holdKey)
            end
        end
        return true
    end

    -- Хук __namecall
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if settings.useRemote and isActive() and not checkcaller()
        and (method == "FireServer" or method == "InvokeServer") then
            local target = getTarget()
            if target then
                local pos = getPredicted(target)
                if pos then
                    for i, v in ipairs(args) do
                        if typeof(v) == "Vector3" then
                            args[i] = pos
                        elseif typeof(v) == "CFrame" then
                            args[i] = CFrame.new(pos)
                        end
                    end
                    return oldNamecall(self, table.unpack(args))
                end
            end
        end
        return oldNamecall(self, ...)
    end)
    track(name, { Disconnect = function()
        if oldNamecall then hookmetamethod(game, "__namecall", oldNamecall) end
    end })

    -- Хук __index (Mouse.Hit / Mouse.Target)
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if settings.useMouse and isActive() and not checkcaller() then
            if self == myMouse and (key == "Hit" or key == "Target") then
                local target = getTarget()
                if target then
                    local pos = getPredicted(target)
                    if pos then
                        if key == "Hit" then return CFrame.new(pos)
                        elseif key == "Target" then return target.Character end
                    end
                end
            end
        end
        return oldIndex(self, key)
    end)
    track(name, { Disconnect = function()
        if oldIndex then hookmetamethod(game, "__index", oldIndex) end
    end })

    track(name, player.CharacterAdded:Connect(function(char) localCharRef = char end))

    print("[FLICK] Aimbot: супер-точный режим | target = " .. settings.targetPart)
end


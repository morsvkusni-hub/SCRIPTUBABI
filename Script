Module:CreateModule("ESP", function(Module)
    local ESP = {}
    local Cached = {}
    local ColorMap = {
        Red = Color3.fromRGB(255, 60, 60), Orange = Color3.fromRGB(255, 150, 40),
        Yellow = Color3.fromRGB(255, 220, 60), Green = Color3.fromRGB(80, 255, 100),
        Cyan = Color3.fromRGB(60, 220, 255), Blue = Color3.fromRGB(90, 130, 255),
        Purple = Color3.fromRGB(190, 90, 255), Pink = Color3.fromRGB(255, 120, 200),
    }

    local Circle = Drawing.new("Circle")
    Circle.Thickness = 1; Circle.Filled = false; Circle.Visible = false

    function ESP:IsAlive(Character)
        if not Character or not Character.Parent then return false end
        if Character:GetAttribute("Alive") == false then return false end
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then return false end
        return true
    end

    function ESP:IsEnemy(Player)
        if not Settings.ESPCheckTeam then return true end
        local LocalTeam = LocalPlayer.Team
        if not LocalTeam or Player.Neutral or LocalPlayer.Neutral then return true end
        return Player.Team ~= LocalTeam
    end

    function ESP:IsValidTarget(Target)
        local Character = Target.Character
        local IsBot = Character and Character:GetAttribute("IsBot") == true
        if not IsBot and Target == LocalPlayer then return false end
        if not Character or not Character.Parent then return false end
        if not IsBot and not self:IsEnemy(Target) then return false end
        return self:IsAlive(Character)
    end

    function ESP:GetTargets()
        local Targets = {}
        for Index, Player in Players:GetPlayers() do table.insert(Targets, Player) end
        if Settings.ESPTargetBots then
            for Index, Model in workspace:GetChildren() do
                if not Model:IsA("Model") then continue end
                if Model:GetAttribute("IsBot") ~= true then continue end
                if Model == LocalPlayer.Character then continue end
                table.insert(Targets, { Name = Model.Name, Character = Model })
            end
        end
        return Targets
    end

    function ESP:GetColor() return ColorMap[Settings.ESPColor or "Red"] or ColorMap.Red end

    function ESP:CreateSquare()
        local b = Drawing.new("Square"); b.Thickness = 1; b.Visible = false; return b
    end
    function ESP:CreateText()
        local t = Drawing.new("Text"); t.Center = true; t.Outline = true
        t.OutlineColor = Color3.new(0, 0, 0); t.Visible = false; return t
    end
    function ESP:CreateLine()
        local l = Drawing.new("Line"); l.Thickness = 1; l.Visible = false; return l
    end
    function ESP:CreateData()
        return {
            Box = ESP:CreateSquare(), Outline = ESP:CreateSquare(),
            Name = ESP:CreateText(), Tracer = ESP:CreateLine(),
        }
    end
    function ESP:HideData(Data)
        Data.Box.Visible = false; Data.Outline.Visible = false
        Data.Name.Visible = false; Data.Tracer.Visible = false
    end
    function ESP:Hide()
        for I, D in Cached do ESP:HideData(D) end
        Circle.Visible = false
    end
    ESP.RemovePlayer = function(Player)
        local Data = Cached[Player]; if not Data then return end
        Data.Box:Remove(); Data.Outline:Remove()
        Data.Name:Remove(); Data.Tracer:Remove()
        Cached[Player] = nil
    end

    function ESP:UpdateBox(Box, Outline, HeadPoint, RootPoint, Opacity)
        local H = RootPoint.Y - HeadPoint.Y
        if H <= 0 then Box.Visible = false; Outline.Visible = false; return end
        local W = math.max(H * 0.6, 4)
        if Settings.ESPBoxOutline then
            Outline.Filled = true
            Outline.Position = Vector2.new(RootPoint.X - W/2, HeadPoint.Y) - Vector2.new(1, 1)
            Outline.Size = Vector2.new(W, H) + Vector2.new(2, 2)
            Outline.Color = Color3.new(0, 0, 0); Outline.Transparency = Opacity
            Outline.Visible = true
        else Outline.Visible = false end
        Box.Position = Vector2.new(RootPoint.X - W/2, HeadPoint.Y)
        Box.Size = Vector2.new(W, H); Box.Color = self:GetColor()
        Box.Transparency = Opacity; Box.Visible = true
    end

    function ESP:UpdateName(Name, Target, HeadPoint, Distance, Opacity)
        local Text = Target.Name
        if Settings.ESPShowDistance then Text ..= string.format(" [%dm]", math.round(Distance)) end
        Name.Position = Vector2.new(HeadPoint.X, HeadPoint.Y - 16); Name.Text = Text
        Name.Color = self:GetColor(); Name.Size = Settings.ESPNameSize or 13
        Name.Transparency = Opacity; Name.Visible = true
    end

    function ESP:UpdateTracer(Tracer, RootPoint, Opacity)
        local Cam = workspace.CurrentCamera; if not Cam then return end
        Tracer.From = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y)
        Tracer.To = Vector2.new(RootPoint.X, RootPoint.Y)
        Tracer.Color = self:GetColor(); Tracer.Transparency = Opacity; Tracer.Visible = true
    end

    function ESP:UpdateCircle(Opacity)
        local Cam = workspace.CurrentCamera; if not Cam then return end
        Circle.Position = Cam.ViewportSize / 2; Circle.Radius = Settings.ESPFOV or 100
        Circle.Color = self:GetColor(); Circle.Transparency = Opacity; Circle.Visible = true
    end

    function ESP:UpdatePlayer(Target, Cam, Opacity)
        local Character = Target.Character
        local IsBot = Character and Character:GetAttribute("IsBot") == true
        local Key = IsBot and Character or Target
        local Data = Cached[Key]
        if not Data then Data = ESP:CreateData(); Cached[Key] = Data end
        if not self:IsValidTarget(Target) then self:HideData(Data); return end
        local HRP = Character:FindFirstChild("HumanoidRootPart")
        if not HRP then self:HideData(Data); return end
        local Dist = (HRP.Position - Cam.CFrame.Position).Magnitude
        if Dist > (Settings.ESPDistance or 300) then self:HideData(Data); return end
        local Head = Character:FindFirstChild("Head") or HRP
        local RP, RO = Cam:WorldToViewportPoint(HRP.Position)
        local HP, HO = Cam:WorldToViewportPoint(Head.Position)
        if not RO or not HO then self:HideData(Data); return end
        if Settings.ESPBox then self:UpdateBox(Data.Box, Data.Outline, HP, RP, Opacity)
        else Data.Box.Visible = false end
        if Settings.ESPName then self:UpdateName(Data.Name, Target, HP, Dist, Opacity)
        else Data.Name.Visible = false end
        if Settings.ESPTracer then self:UpdateTracer(Data.Tracer, RP, Opacity)
        else Data.Tracer.Visible = false end
    end

    function ESP:Update()
        if not Settings.ESP then self:Hide(); return end
        local Cam = workspace.CurrentCamera
        local Op = Settings.ESPOpacity or 1
        if Settings.ESPFOVCircle then self:UpdateCircle(Op) else Circle.Visible = false end
        if not Cam then return end
        for I, T in self:GetTargets() do self:UpdatePlayer(T, Cam, Op) end
    end

    function ESP:Clear()
        for I, D in Cached do
            D.Box:Remove(); D.Outline:Remove(); D.Name:Remove(); D.Tracer:Remove()
        end
        table.clear(Cached); Circle:Remove()
    end

    _ENV.NextESP = ESP
    return ESP
end)


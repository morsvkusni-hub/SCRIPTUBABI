    bg.Position = UDim2.new(0.5, -170, 0.5, -115)
    bg.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    bg.BorderSizePixel = 0; bg.Parent = kgui
    Instance.new("UICorner", bg).CornerRadius = UDim.new(0, 10)
    local st = Instance.new("UIStroke", bg)
    st.Color = Color3.fromRGB(255, 90, 90); st.Thickness = 1

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40); title.BackgroundTransparency = 1
    title.Text = "@kotyk_software"; title.TextColor3 = Color3.fromRGB(255, 90, 90)
    title.TextSize = 20; title.Font = Enum.Font.GothamBold; title.Parent = bg

    local sub = Instance.new("TextLabel")
    sub.Size = UDim2.new(1, 0, 0, 16); sub.Position = UDim2.new(0, 0, 0, 38)
    sub.BackgroundTransparency = 1; sub.Text = "Enter key or try DEMO"
    sub.TextColor3 = Color3.fromRGB(150, 150, 160)
    sub.TextSize = 11; sub.Font = Enum.Font.Gotham; sub.Parent = bg

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -40, 0, 36); box.Position = UDim2.new(0, 20, 0, 62)
    box.BackgroundColor3 = Color3.fromRGB(28, 28, 34); box.BorderSizePixel = 0
    box.PlaceholderText = "Key..."; box.Text = ""
    box.TextColor3 = Color3.fromRGB(230, 230, 235)
    box.PlaceholderColor3 = Color3.fromRGB(120, 120, 130)
    box.TextSize = 14; box.Font = Enum.Font.GothamMedium
    box.ClearTextOnFocus = false; box.Parent = bg
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    -- Кнопка Submit
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.5, -25, 0, 34); btn.Position = UDim2.new(0, 20, 0, 106)
    btn.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
    btn.Text = "Submit"; btn.TextColor3 = Color3.new(1,1,1)
    btn.TextSize = 14; btn.Font = Enum.Font.GothamBold; btn.Parent = bg
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    -- Кнопка DEMO
    local demoBtn = Instance.new("TextButton")
    demoBtn.Size = UDim2.new(0.5, -25, 0, 34); demoBtn.Position = UDim2.new(0.5, 5, 0, 106)
    demoBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    demoBtn.Text = "DEMO"; demoBtn.TextColor3 = Color3.fromRGB(230, 230, 235)
    demoBtn.TextSize = 14; demoBtn.Font = Enum.Font.GothamBold; demoBtn.Parent = bg
    Instance.new("UICorner", demoBtn).CornerRadius = UDim.new(0, 6)

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -20, 0, 30); status.Position = UDim2.new(0, 10, 0, 150)
    status.BackgroundTransparency = 1; status.Text = ""
    status.TextColor3 = Color3.fromRGB(255, 90, 90)
    status.TextSize = 12; status.Font = Enum.Font.Gotham
    status.TextWrapped = true; status.Parent = bg

    local done = false

    -- === ДЕМО-РЕЖИМ ===
    demoBtn.MouseButton1Click:Connect(function()
        box.Text = ""
        status.TextColor3 = Color3.fromRGB(255, 200, 80)
        status.Text = "Это демо-режим.\nКупите ключ у @kotyk_prostoy"
        demoBtn.Text = "3..."
        task.wait(1); if demoBtn.Parent then demoBtn.Text = "2..." end
        task.wait(1); if demoBtn.Parent then demoBtn.Text = "1..." end
        task.wait(1)
        -- закрываем всё, ничего не работает
        if kgui and kgui.Parent then kgui:Destroy() end
        warn("[@kotyk_software] DEMO MODE — купите ключ у @kotyk_prostoy")
    end)

    -- === SUBMIT ===
    local function try()
        if box.Text == VALID_KEY then
            done = true; status.Text = "Access granted!"
            status.TextColor3 = Color3.fromRGB(80, 200, 120)
            task.wait(0.4); kgui:Destroy()
        else
            status.Text = "Wrong key! Купите у @kotyk_prostoy"
            status.TextColor3 = Color3.fromRGB(255, 90, 90)
            box.Text = ""
        end
    end
    btn.MouseButton1Click:Connect(try)
    box.FocusLost:Connect(function(e) if e then try() end end)

    repeat task.wait(0.1) until done or not kgui.Parent
    return done
end

if not keyCheck() then return end


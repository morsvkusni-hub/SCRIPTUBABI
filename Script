-- 5. ESP Lines / Boxes
Features["ESP Lines / Boxes"] = function(on, name)
    clearFeature(name)
    if not on or not hasDrawing() then return end
    local boxes, lines = {}, {}
    local function mk(plr)
        local b = Drawing.new("Square")
        b.Thickness, b.Color, b.Filled, b.Visible = 1, Color3.fromRGB(255,80,80), false, false
        track(name, b); boxes[plr] = b
        local l = Drawing.new("Line")
        l.Thickness, l.Color, l.Visible = 1, Color3.fromRGB(255,80,80), false
        track(name, l); lines[plr] = l
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then mk(plr) end
    end
    track(name, RunService.RenderStepped:Connect(function()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == player then continue end
            if not boxes[plr] then mk(plr) end
            local hrp = otherRoot(plr)
            if hrp then
                local pos, onS = camera:WorldToViewportPoint(hrp.Position)
                if onS then
                    local head = plr.Character:FindFirstChild("Head")
                    local hp = head and camera:WorldToViewportPoint(head.Position)
                    local h = hp and math.abs(hp.Y - pos.Y) * 1.8 or 60
                    local w = h * 0.5
                    boxes[plr].Size = Vector2.new(w, h)
                    boxes[plr].Position = Vector2.new(pos.X - w/2, pos.Y - h/2)
                    boxes[plr].Visible = true
                    lines[plr].From = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y)
                    lines[plr].To = Vector2.new(pos.X, pos.Y)
                    lines[plr].Visible = true
                else
                    boxes[plr].Visible = false
                    lines[plr].Visible = false
                end
            else
                if boxes[plr] then boxes[plr].Visible = false end
                if lines[plr] then lines[plr].Visible = false end
            end
        end
    end))
end


Module:CreateModule("Aimbot", function(Module)
    local Aimbot = {}
    local Shared = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Shared")
    local DeagleShared = require(Shared:WaitForChild("DeagleShared"))
    local CachedTarget = nil

    if not _ENV.NextOriginalRaycast then
        _ENV.NextOriginalRaycast = DeagleShared.Raycast
    end

    function Aimbot:IsAlive(Character)
        if not Character or not Character.Parent then return false end
        if Character:GetAttribute("Alive") == false then return false end
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then return false end
        return true
    end

    function Aimbot:IsEnemy(Player)
        if not Settings.CheckTeam then return true end
        local LocalTeam = LocalPlayer.Team
        if not LocalTeam or Player.Neutral or LocalPlayer.Neutral then return true end
        return Player.Team ~= LocalTeam
    end

    function Aimbot:IsValidTarget(Target)
        local Character = Target.Character
        local IsBot = Character and Character:GetAttribute("IsBot") == true
        if not IsBot and Target == LocalPlayer then return false end
        if not Character or not Character.Parent then return false end
        if not IsBot and not self:IsEnemy(Target) then return false end
        return self:IsAlive(Character)
    end

    function Aimbot:GetTargets()
        local Targets = {}
        for Index, Player in Players:GetPlayers() do
            table.insert(Targets, Player)
        end
        if Settings.TargetBots then
            for Index, Model in workspace:GetChildren() do
                if not Model:IsA("Model") then continue end
                if Model:GetAttribute("IsBot") ~= true then continue end
                if Model == LocalPlayer.Character then continue end
                table.insert(Targets, { Name = Model.Name, Character = Model })
            end
        end
        return Targets
    end

    function Aimbot:GetTargetPosition(Character)
        local HRP = Character:FindFirstChild("HumanoidRootPart")
        if not HRP then return nil end
        local Part = Character:FindFirstChild(Settings.TargetPart or "HumanoidRootPart") or HRP
        return Part.Position
    end

    function Aimbot:IsVisible(From, Position, Target)
        if not Settings.CheckWall then return true end
        local Character = LocalPlayer.Character
        local TC = Target and Target.Character
        if not Character or not TC then return false end
        local Params = RaycastParams.new()
        Params.FilterType = Enum.RaycastFilterType.Exclude
        Params.FilterDescendantsInstances = { Character, TC }
        local Result = workspace:Raycast(From, Position - From, Params)
        if not Result then return true end
        return Result.Instance:IsDescendantOf(TC)
    end

    function Aimbot:IsWithinFOV(Position)
        local Cam = workspace.CurrentCamera
        if not Cam then return false end
        local Point, OnScreen = Cam:WorldToViewportPoint(Position)
        if not OnScreen then return false end
        local Center = Cam.ViewportSize / 2
        return (Vector2.new(Point.X, Point.Y) - Center).Magnitude <= (Settings.FOV or 100)
    end

    function Aimbot:FindTarget(From)
        local MaxDistance = Settings.Distance or 300
        local TargetMode = Settings.TargetMode or "Nearest"
        local BestTarget, BestPosition, BestDistance = nil, nil, math.huge

        if CachedTarget and self:IsValidTarget(CachedTarget) then
            local P = self:GetTargetPosition(CachedTarget.Character)
            if P then
                local D = (P - From).Magnitude
                if D <= MaxDistance and self:IsVisible(From, P, CachedTarget) then
                    BestTarget, BestPosition, BestDistance = CachedTarget, P, D
                end
            end
        end

        for Index, Target in self:GetTargets() do
            if not self:IsValidTarget(Target) then continue end
            local Position = self:GetTargetPosition(Target.Character)
            if not Position then continue end
            local Distance = (Position - From).Magnitude
            if Distance > MaxDistance then continue end
            if TargetMode == "FOV" and not self:IsWithinFOV(Position) then continue end
            if not self:IsVisible(From, Position, Target) then continue end
            if Distance >= BestDistance then continue end
            BestTarget, BestPosition, BestDistance = Target, Position, Distance
        end

        if BestTarget then CachedTarget = BestTarget end
        return BestTarget, BestPosition
    end

    function Aimbot:Enable()
        if self.Hooked then return end
        self.Hooked = true
        DeagleShared.Raycast = function(Origin, From, To)
            local Success, Target, TargetPosition = pcall(Aimbot.FindTarget, Aimbot, From)
            if Success and Target and TargetPosition then
                return self.OriginalRaycast(Origin, From, TargetPosition)
            end
            return self.OriginalRaycast(Origin, From, To)
        end
    end

    function Aimbot:Disable()
        if not self.Hooked then return end
        self.Hooked = false
        DeagleShared.Raycast = self.OriginalRaycast
    end

    Aimbot.OriginalRaycast = _ENV.NextOriginalRaycast
    return Aimbot
end)


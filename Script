-- Перехват DescendantAdded, чтобы заменить текст в заголовке
local PG = LP:WaitForChild("PlayerGui")
PG.DescendantAdded:Connect(function(obj)
    if patched then return end
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        task.defer(function()
            local t = obj.Text
            if t and (t:find("vita8it") or t:find("Deagle") or t:find("Aimbot + ESP")) then
                obj.Text = t:gsub("vita8it", "@kotyk_prostoy")
                              :gsub("DeagleArena", "@kotyk_prostoy Hub")
                              :gsub("Made by", "by")
                patched = true
            end
        end)
    end
end)

--==========================================================
--          CONFIG SYSTEM
--==========================================================
local CONFIG_FOLDER = "kotyk_prostoy"
local CONFIG_FILE = "deagle_config.json"

local function ensureFolder()
    if isfolder and not isfolder(CONFIG_FOLDER) then
        pcall(makefolder, CONFIG_FOLDER)
    end
end

local function saveConfig(data)
    ensureFolder()
    if writefile then
        pcall(writefile, CONFIG_FOLDER .. "/" .. CONFIG_FILE, HttpService:JSONEncode(data))
        return true
    end
    return false
end

local function loadConfig()
    ensureFolder()
    if isfile and isfile(CONFIG_FOLDER .. "/" .. CONFIG_FILE) then
        local ok, content = pcall(readfile, CONFIG_FOLDER .. "/" .. CONFIG_FILE)
        if ok and content then
            local ok2, data = pcall(HttpService.JSONDecode, HttpService, content)
            if ok2 then return data end
        end
    end
    return nil
end


                d.Enabled = false
            end
        end
        activeData[name] = disabled
    else
        local list = activeData[name]
        if list then
            for obj, st in pairs(list) do
                if obj and obj.Parent then obj.Enabled = st end
            end
            activeData[name] = nil
        end
    end
end

-- 17. SpeedHack / Fly
Features["SpeedHack / Fly"] = function(on, name)
    clearFeature(name)
    if not on then return end
    local speed = 100
    track(name, RunService.Heartbeat:Connect(function()
        local hum = localHum()
        if hum then hum.WalkSpeed = speed end
    end))
    local function setupFly()
        local root = localRoot(); if not root then return end
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e5,1e5,1e5)
        bv.Velocity = Vector3.zero
        bv.Parent = root
        track(name, bv)
        track(name, RunService.RenderStepped:Connect(function()
            local move = Vector3.zero
            if UIS:IsKeyDown(Enum.KeyCode.W) then move += camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.S) then move -= camera.CFrame.LookVector end
            if UIS:IsKeyDown(Enum.KeyCode.A) then move -= camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.D) then move += camera.CFrame.RightVector end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0,1,0) end
            if move.Magnitude > 0 then move = move.Unit * 60 end
            if root and bv.Parent then bv.Velocity = move end
        end))
    end
    if localRoot() then setupFly() end
    track(name, player.CharacterAdded:Connect(function() task.wait(0.5); setupFly() end))
end


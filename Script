--==========================================================
--          MOVEMENT TAB
--==========================================================
local MovementTab = Plugins:CreateTab({ "Movement", "Fly, jump and spin" }) do
    MovementTab:Section("Fly", function(Section)
        Plugins:SetDefault("Fly", false)
        Plugins:SetDefault("FlySpeed", 60)

        Plugins:Toggle(Section, { "Fly", "WASD move, Space up, LeftCtrl down" }, "Fly", function(v)
            if v then Movement:StartFly() else Movement:StopFly() end
        end)
        Plugins:Slider(Section, { "Fly Speed", "Speed of flight" }, { 20, 300, 5 }, "FlySpeed", function(v)
            Movement:SetFlySpeed(v)
        end)
    end)

    MovementTab:Section("Jump", function(Section)
        Plugins:SetDefault("InfiniteJump", false)
        Plugins:Toggle(Section, { "Infinite Jump", "Jump as many times as you want" }, "InfiniteJump", function(v)
            if v then Movement:StartInfiniteJump() else Movement:StopInfiniteJump() end
        end)
    end)

    MovementTab:Section("Spin Bot", function(Section)
        Plugins:SetDefault("SpinBot", false)
        Plugins:SetDefault("SpinSpeed", 15)

        Plugins:Toggle(Section, { "Spin Bot", "Constantly rotate your character" }, "SpinBot", function(v)
            if v then Movement:StartSpinBot() else Movement:StopSpinBot() end
        end)
        Plugins:Slider(Section, { "Spin Speed", "Degrees per frame" }, { 1, 60, 1 }, "SpinSpeed", function(v)
            Movement:SetSpinSpeed(v)
        end)
    end)

    MovementTab:Section("Camera", function(Section)
        Plugins:SetDefault("ThirdPerson", false)
        Plugins:Toggle(Section, { "Third Person View", "Zoom out your camera" }, "ThirdPerson", function(v)
            if v then Movement:StartThirdPerson() else Movement:StopThirdPerson() end
        end)
    end)
end


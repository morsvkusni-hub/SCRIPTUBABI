do
    local drag, startPos, startMouse
    TitleBar.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            drag = true; startMouse = i.Position; startPos = Window.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - startMouse
            Window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                        startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then drag = false end
    end)
end

--==========================================================
--              SILENT AIM (только __index — безопасный)
--==========================================================
local SilentHooks = {}
local silentActive = false

local function getSilentTarget()
    local s = Config.SilentAim
    local myRoot = getRoot(); if not myRoot then return nil end
    local closest, best = nil, s.FOV
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if s.TeamCheck and plr.Team and plr.Team == LP.Team then continue end
        local char = plr.Character; if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(s.TargetPart); if not part then continue end
        local dist = (part.Position - myRoot.Position).Magnitude
        if dist > s.MaxDistance then continue end
        local sp, onS = Camera:WorldToViewportPoint(part.Position)
        if not onS then continue end
        if s.WallCheck then
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = {LP.Character}
            local ray = Workspace:Raycast(Camera.CFrame.Position,
                (part.Position - Camera.CFrame.Position).Unit * 1000, rp)
            if ray and not ray.Instance:IsDescendantOf(char) then continue end
        end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < best then closest, best = plr, d end
    end
    return closest
end

local function getSilentPredicted(target)
    local s = Config.SilentAim
    local char = target and target.Character; if not char then return nil end
    local part = char:FindFirstChild(s.TargetPart); if not part then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.MoveDirection.Magnitude > 0 then
        return part.Position + hum.MoveDirection * hum.WalkSpeed * s.Prediction
    end
    return part.Position
end

local function startSilent()
    if SilentHooks.index then return end
    local myMouse = LP:GetMouse()
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if Config.SilentAim.Enabled and not checkcaller() then
            if self == myMouse and (key == "Hit" or key == "Target") then
                local t = getSilentTarget()
                if t then
                    local pos = getSilentPredicted(t)
                    if pos then
                        if key == "Hit" then return CFrame.new(pos)
                        elseif key == "Target" then return t.Character end
                    end
                end
            end
        end
        return oldIndex(self, key)
    end)
    SilentHooks.index = oldIndex
    print("[@kotyk_software] Silent Aim: ON (__index only)")
end

local function stopSilent()
    if SilentHooks.index then
        hookmetamethod(game, "__index", SilentHooks.index)
        SilentHooks.index = nil
    end
    print("[@kotyk_software] Silent Aim: OFF")
end

RunService.Heartbeat:Connect(function()
    if Config.SilentAim.Enabled and not silentActive then
        silentActive = true; startSilent()
    elseif not Config.SilentAim.Enabled and silentActive then
        silentActive = false; stopSilent()
    end
end)


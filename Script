Features["Trigger Bot"] = function(on, name)
    clearFeature(name)
    if not on then return end
    track(name, RunService.RenderStepped:Connect(function()
        local mp = UIS:GetMouseLocation()
        local unit = camera:ViewportPointToRay(mp.X, mp.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {localChar()}
        local hit = Workspace:Raycast(unit.Origin, unit.Direction * 500, params)
        if hit and hit.Instance then
            local model = hit.Instance:FindFirstAncestorOfClass("Model")
            if model and Players:GetPlayerFromCharacter(model) then
                local tool = localChar() and localChar():FindFirstChildOfClass("Tool")
                if tool then pcall(function() tool:Activate() end) end
            end
        end
    end))
end


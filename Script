    box.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
    box.BorderSizePixel = 0
    box.PlaceholderText = "Key..."
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(230, 230, 235)
    box.PlaceholderColor3 = Color3.fromRGB(120, 120, 130)
    box.TextSize = 14
    box.Font = Enum.Font.GothamMedium
    box.ClearTextOnFocus = false
    box.Parent = bg
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -40, 0, 38)
    btn.Position = UDim2.new(0, 20, 0, 112)
    btn.BackgroundColor3 = Color3.fromRGB(255, 90, 90)
    btn.Text = "Submit"
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamBold
    btn.Parent = bg
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, -20, 0, 20)
    status.Position = UDim2.new(0, 10, 0, 158)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(255, 90, 90)
    status.TextSize = 12
    status.Font = Enum.Font.GothamMedium
    status.Parent = bg

    local footer = Instance.new("TextLabel")
    footer.Size = UDim2.new(1, 0, 0, 16)
    footer.Position = UDim2.new(0, 0, 1, -22)
    footer.BackgroundTransparency = 1
    footer.Text = "Купить ключ у @kotyk_prostoy"
    footer.TextColor3 = Color3.fromRGB(120, 120, 130)
    footer.TextSize = 11
    footer.Font = Enum.Font.Gotham
    footer.Parent = bg

    local done = false
    local function try()
        if box.Text == VALID_KEY then
            done = true
            status.Text = "Access granted!"
            status.TextColor3 = Color3.fromRGB(80, 200, 120)
            task.wait(0.4)
            if kgui and kgui.Parent then kgui:Destroy() end
        else
            status.Text = "Неверный ключ!"
            status.TextColor3 = Color3.fromRGB(255, 90, 90)
            box.Text = ""
        end
    end
    btn.MouseButton1Click:Connect(try)
    box.FocusLost:Connect(function(enter) if enter then try() end end)

    repeat task.wait(0.1) until done or not kgui.Parent
    return done
end

if not keyCheck() then return end


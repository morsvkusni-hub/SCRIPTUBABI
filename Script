--====================== STATE ======================--
local activeConn = {}
local activeInst = {}
local activeDraw = {}
local activeData = {}

local function track(name, ...)
    for _, v in ipairs({...}) do
        local t = typeof(v)
        if t == "RBXScriptConnection" then
            activeConn[name] = activeConn[name] or {}
            table.insert(activeConn[name], v)
        elseif t == "Instance" then
            activeInst[name] = activeInst[name] or {}
            table.insert(activeInst[name], v)
        elseif t == "table" and v.Disconnect then
            activeInst[name] = activeInst[name] or {}
            table.insert(activeInst[name], v) -- кастомный объект с Disconnect
        else
            activeDraw[name] = activeDraw[name] or {}
            table.insert(activeDraw[name], v)
        end
    end
end

function clearFeature(name)
    if activeConn[name] then
        for _, c in ipairs(activeConn[name]) do pcall(function() c:Disconnect() end) end
        activeConn[name] = nil
    end
    if activeInst[name] then
        for _, i in ipairs(activeInst[name]) do
            pcall(function()
                if i.Disconnect then i:Disconnect() else i:Destroy() end
            end)
        end
        activeInst[name] = nil
    end
    if activeDraw[name] then
        for _, d in ipairs(activeDraw[name]) do pcall(function() d:Remove() end) end
        activeDraw[name] = nil
    end
end

local function hasDrawing() return rawget(_G, "Drawing") ~= nil end
local function localChar() return player.Character end
local function localRoot()
    local c = localChar()
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end
local function localHum()
    local c = localChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function otherRoot(plr)
    local c = plr.Character
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end

close.MouseButton1Click:Connect(function()
    for name in pairs(activeConn) do clearFeature(name) end
    for name in pairs(activeInst) do clearFeature(name) end
    for name in pairs(activeDraw) do clearFeature(name) end
    gui:Destroy()
end)


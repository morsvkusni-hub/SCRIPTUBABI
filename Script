RunService.RenderStepped:Connect(function()
    if not Config.Aimbot.Enabled then return end
    local s = Config.Aimbot
    local closest, best = nil, s.FOV
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        if s.TeamCheck and plr.Team and plr.Team == LP.Team then continue end
        local char = plr.Character; if not char then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local part = char:FindFirstChild(s.TargetPart); if not part then continue end
        local sp, onS = Camera:WorldToViewportPoint(part.Position)
        if not onS then continue end
        local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if d < best then closest, best = part, d end
    end
    if closest then
        local target = CFrame.new(Camera.CFrame.Position, closest.Position)
        Camera.CFrame = Camera.CFrame:Lerp(target, s.Smoothness)
    end
end)

--==========================================================
--              ESP
--==========================================================
local ESP = {boxes = {}, tracers = {}, conn = nil}

local function mkESP(plr)
    if not hasDrawing() then return end
    local box = Drawing.new("Square")
    box.Thickness, box.Color, box.Filled, box.Visible = 1, Color3.fromRGB(255,80,80), false, false
    ESP.boxes[plr] = box
    local line = Drawing.new("Line")
    line.Thickness, line.Color, line.Visible = 1, Color3.fromRGB(255,80,80), false
    ESP.tracers[plr] = line
end

function startESP()
    if not hasDrawing() or ESP.conn then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then mkESP(p) end
    end
    ESP.conn = RunService.RenderStepped:Connect(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            if not ESP.boxes[p] then mkESP(p) end
            local hrp = otherRoot(p)
            if hrp then
                local pos, onS = Camera:WorldToViewportPoint(hrp.Position)
                if onS then
                    local head = p.Character:FindFirstChild("Head")
                    local hp = head and Camera:WorldToViewportPoint(head.Position)
                    local h = hp and math.abs(hp.Y - pos.Y) * 1.8 or 60
                    local w = h * 0.5
                    if Config.Visuals.ESP then
                        ESP.boxes[p].Size = Vector2.new(w, h)
                        ESP.boxes[p].Position = Vector2.new(pos.X - w/2, pos.Y - h/2)
                        ESP.boxes[p].Visible = true
                    else
                        ESP.boxes[p].Visible = false
                    end
                    if Config.Visuals.Tracers then
                        ESP.tracers[p].From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                        ESP.tracers[p].To = Vector2.new(pos.X, pos.Y)
                        ESP.tracers[p].Visible = true
                    else
                        ESP.tracers[p].Visible = false
                    end
                else
                    ESP.boxes[p].Visible = false
                    ESP.tracers[p].Visible = false
                end
            else
                if ESP.boxes[p] then ESP.boxes[p].Visible = false end
                if ESP.tracers[p] then ESP.tracers[p].Visible = false end
            end
        end
    end)
end

function stopESP()
    if ESP.conn then ESP.conn:Disconnect(); ESP.conn = nil end
    for p, b in pairs(ESP.boxes) do b:Remove(); ESP.boxes[p] = nil end
    for p, l in pairs(ESP.tracers) do l:Remove(); ESP.tracers[p] = nil end
end

